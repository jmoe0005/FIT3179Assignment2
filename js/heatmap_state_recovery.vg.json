{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap: change in overnight trips to each state compared with 2019, by year",
  "width": "container",
  "height": 280,
  "autosize": {"type": "fit-x", "contains": "padding"},
  "data": {"url": "data/trips_state_year.csv"},
  "transform": [
    {"calculate": "datum.year == 2019 ? datum.trips_000 : null", "as": "base_candidate"},
    {
      "joinaggregate": [{"op": "max", "field": "base_candidate", "as": "base2019"}],
      "groupby": ["state"]
    },
    {"calculate": "(datum.trips_000 - datum.base2019) / datum.base2019", "as": "change"},
    {
      "calculate": "datum.state == 'Australian Capital Territory' ? 'ACT' : datum.state",
      "as": "State"
    },
    {"calculate": "datum.trips_000/1000", "as": "trips_m"}
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Year ending December",
      "axis": {"labelAngle": 0, "domain": false, "ticks": false}
    },
    "y": {
      "field": "State",
      "type": "nominal",
      "title": null,
      "sort": {"field": "change", "op": "min", "order": "ascending"},
      "axis": {"domain": false, "ticks": false, "labelLimit": 260, "minExtent": 140, "labelPadding": 8}
    }
  },
  "layer": [
    {
      "mark": {"type": "rect", "stroke": "#ffffff", "strokeWidth": 2},
      "encoding": {
        "color": {
          "field": "change",
          "type": "quantitative",
          "title": "Change in trips since 2019",
          "scale": {"domain": [-0.5, 0, 0.5], "range": ["#b8472e", "#f3efe7", "#1f7a6d"]},
          "legend": {
            "format": "+.0%",
            "orient": "top",
            "direction": "horizontal",
            "gradientLength": 220,
            "values": [-0.4, -0.2, 0, 0.2, 0.4]
          }
        },
        "tooltip": [
          {"field": "state", "title": "Destination"},
          {"field": "year", "title": "Year"},
          {"field": "trips_m", "title": "Overnight trips (millions)", "format": ".1f"},
          {"field": "change", "title": "Change since 2019", "format": "+.0%"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.year != 2019"}],
      "mark": {"type": "text", "fontSize": 12},
      "encoding": {
        "text": {"field": "change", "type": "quantitative", "format": "+.0%"},
        "color": {
          "condition": {"test": "abs(datum.change) > 0.3", "value": "#ffffff"},
          "value": "#222222"
        }
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Source Sans 3",
    "axis": {"labelFontSize": 13, "titleFontSize": 13, "titleColor": "#555"},
    "legend": {"labelFontSize": 13, "titleFontSize": 13}
  }
}
